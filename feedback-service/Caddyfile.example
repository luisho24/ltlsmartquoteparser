# Alternative host deployment. Use your verified hostname and merge this site block.
feedback.example.com {
    tls {
        issuer acme {
            preferred_chains {
                root_common_name "ISRG Root X1"
            }
        }
    }
    request_body {
        max_size 200KB
    }
    reverse_proxy 127.0.0.1:8787 {
        header_up X-Forwarded-For {remote_host}
    }
}
